meta {
  name: Generate Response
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/ai/generate
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "prompt": "What is dependency injection in Java?"
  }
}

assert {
  res.status: 200
}

tests {
  test("HTTP status is 200", function() {
    expect(res.status).to.equal(200);
  });
  
  test("provider is Ollama", function() {
    expect(res.body.provider).to.equal("ollama");
  });
  
  test("response is not empty", function() {
    expect(res.body.response).to.be.a("string").and.not.empty;
  });
}
