meta {
  name: Health Check
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/health
  body: none
  auth: none
}

assert {
  res.status: 200
}

tests {
  test("HTTP status is 200", function() {
    expect(res.status).to.equal(200);
  });

  test("response identifies NEXUS AI", function() {
    expect(res.body.application).to.equal("NEXUS AI");
  });

  test("application health is UP", function() {
    expect(res.body.status).to.equal("UP");
  });
}
